# Public hostname and URL for your PairDrop instance.
MUMBLE_SHARE_HOST=share.example.com
MUMBLE_SHARE_BASE_URL=https://share.example.com/

# Public address used by coturn. Keep the relay port range in sync with your
# firewall.
MUMBLE_SHARE_PUBLIC_IP=203.0.113.10

# Generate a unique value during deployment. Never commit the real password.
TURN_PASSWORD=replace-with-a-generated-secret
